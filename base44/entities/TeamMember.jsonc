{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Full name"
    },
    "role": {
      "type": "string",
      "description": "Role or title"
    },
    "bio": {
      "type": "string",
      "description": "Short bio"
    },
    "photo_url": {
      "type": "string",
      "description": "Photo link"
    },
    "sort_order": {
      "type": "number",
      "default": 100,
      "description": "Lower numbers show first"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
