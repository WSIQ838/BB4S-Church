{
  "name": "SiteSetting",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Which piece of website text this is, e.g. church.phone"
    },
    "value": {
      "type": "string",
      "description": "The text shown on the website"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
